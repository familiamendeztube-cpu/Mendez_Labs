# Copy this file to  scripts/deploy-backend.env  and fill in your values.
# That file is git-ignored — your keys are never committed.

# ── Required ────────────────────────────────────────────────────────────────

# Supabase personal access token — create at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Alpaca PAPER account API keys — https://app.alpaca.markets (switch to Paper, then "API Keys")
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# The login code for the terminal. Leave as-is unless you want to change it.
TERMINAL_ACCESS_KEY=312593

# AI Research on the Top Five page — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Sports model history. Without these the Elo model has no game history and
# every pick stays "excluded — insufficient history".
#   The Odds API:  https://the-odds-api.com
#   API-Sports:    https://api-sports.io
ODDS_API_KEY=
API_SPORTS_KEY=

# ── Real-money trading (only fill these when you're ready) ──────────────────
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=
# Set to  true  to let the ticket place real orders. Leave blank to keep live
# orders blocked server-side even when the dashboard is in LIVE mode.
ALPACA_LIVE_ORDERS_ENABLED=
