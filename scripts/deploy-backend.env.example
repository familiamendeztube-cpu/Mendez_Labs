# Copy this file to  scripts/deploy-backend.env  and fill in your values.
# That file is git-ignored — your keys are never committed.

# ── Required ────────────────────────────────────────────────────────────────

# Supabase personal access token — create at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Alpaca PAPER account API keys — https://app.alpaca.markets (switch to Paper, then "API Keys")
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# The login code for the terminal. Leave as-is unless you want to change it.
TERMINAL_ACCESS_KEY=312593

# AI Research on the Top Five page — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Sports model history. Without these the Elo model has no game history and
# every pick stays "excluded — insufficient history".
#   The Odds API:  https://the-odds-api.com
#   API-Sports:    https://api-sports.io
ODDS_API_KEY=
API_SPORTS_KEY=

# ── Kraken (crypto — debit-card funding, works in Costa Rica) ───────────────
# Create at https://www.kraken.com/u/security/api with Query Funds + Query
# Orders permission. Add "Create & Modify Orders" only when you want the
# terminal to be able to trade.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Set to  true  to let the order ticket place REAL Kraken orders.
KRAKEN_ORDERS_ENABLED=

# ── Capital.com (CFDs — card funding, PayPal withdrawal, Costa Rica) ────────
# Create the key in the web platform: Settings > API. 2FA must be on first.
# CAPITAL_IDENTIFIER is your login email; CAPITAL_PASSWORD is the password you
# set ON THE API KEY (not your account password).
# NOTE: CFDs are leveraged and you never own the asset. Capital.com discloses
# that 79.58% of retail accounts lose money trading CFDs with them.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
# Set to  true  to allow REAL (non-demo) Capital.com orders.
CAPITAL_ORDERS_ENABLED=

# ── Real-money trading (only fill these when you're ready) ──────────────────
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=
# Set to  true  to let the ticket place real orders. Leave blank to keep live
# orders blocked server-side even when the dashboard is in LIVE mode.
ALPACA_LIVE_ORDERS_ENABLED=
